# Enforce LF line endings for all text files
* text=auto eol=lf

# Rust sources
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.webp binary
